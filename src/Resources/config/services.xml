<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>

        <service id="SyncEngine\Shopware\" resource="../../"/>

        <service id="SyncEngine\Shopware\Service\ShopwarePayloadService">
            <argument type="service" id="product.repository"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="customer.repository"/>
        </service>

        <service id="SyncEngine\Shopware\Controller\SyncEngineController" public="true">
            <tag name="controller.service_arguments"/>
        </service>

        <service id="SyncEngine\Shopware\Subscriber\EntityTriggerSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="SyncEngine\Shopware\Subscriber\SystemConfigSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>