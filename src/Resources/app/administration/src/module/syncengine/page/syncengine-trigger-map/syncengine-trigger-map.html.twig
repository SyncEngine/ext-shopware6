{% block syncengine_trigger_map_page %}
    <sw-page class="syncengine-trigger-map-page">
        <template #smart-bar-header>
            <h2>SyncEngine Trigger Map</h2>
        </template>

        <template #smart-bar-actions>
            <sw-button-process
                :isLoading="isRefreshing"
                :processSuccess="false"
                variant="primary"
                @click="onRefresh"
            >
                Refresh map
            </sw-button-process>
        </template>

        <template #content>
            <sw-card-view>
                <sw-card title="Mapped Trigger Endpoints" :isLoading="isLoading">
                    <sw-description-list grid="1fr 2fr" class="syncengine-trigger-map-page__meta">
                        <dt>Last map update</dt>
                        <dd>{{ updatedAtLabel }}</dd>
                    </sw-description-list>

                    <sw-alert v-if="error" variant="error" appearance="notification">
                        {{ error }}
                    </sw-alert>

                    <sw-empty-state
                        v-if="!isLoading && rows.length === 0"
                        title="No trigger mappings found"
                        subline="Create or update automations to populate this list."
                    />

                    <sw-data-grid
                        v-if="rows.length > 0"
                        :dataSource="rows"
                        :columns="columns"
                        :showSelection="false"
                        :showActions="false"
                        :allowInlineEdit="false"
                        :allowColumnEdit="false"
                    >
                        <template #column-trigger="{ item }">
                            <strong>{{ item.trigger }}</strong>
                        </template>

                        <template #column-endpointCount="{ item }">
                            <sw-label size="small" variant="neutral" appearance="pill">
                                {{ item.endpointCount }}
                            </sw-label>
                        </template>

                        <template #column-endpointList="{ item }">
                            <span v-if="item.endpoints.length === 0">-</span>
                            <div v-else>
                                <sw-label
                                    v-for="endpoint in item.endpoints"
                                    :key="endpoint"
                                    size="small"
                                    variant="info"
                                    appearance="pill"
                                    class="syncengine-trigger-map-page__endpoint"
                                >
                                    {{ endpoint }}
                                </sw-label>
                            </div>
                        </template>
                    </sw-data-grid>
                </sw-card>
            </sw-card-view>
        </template>
    </sw-page>
{% endblock %}
