{% block syncengine_trigger_endpoint_modal %}
<sw-modal
    class="syncengine-trigger-endpoint-modal"
    title="Trigger SyncEngine Endpoint"
    @modal-close="onClose"
>
    {% block syncengine_trigger_endpoint_modal_content %}
        <sw-single-select
            v-model:value="endpoint"
            label="Endpoint"
            :options="endpointOptions"
            :is-loading="isLoadingEndpoints"
            :placeholder="isLoadingEndpoints ? 'Loading endpoints...' : 'Select an endpoint'"
            value-property="value"
            label-property="label"
            required
        />

        <sw-text-field
            v-model:value="triggerEventName"
            label="Trigger event name (optional)"
            placeholder="default"
            help-text="The event name sent to SyncEngine. When empty it is auto-derived from the flow name."
        />

        <sw-textarea-field
            v-model:value="custom"
            label="Custom payload JSON (optional)"
            placeholder="{ }"
            rows="8"
        />
    {% endblock %}

    {% block syncengine_trigger_endpoint_modal_footer %}
        <template #modal-footer>
            <sw-button
                size="small"
                @click="onClose"
            >
                Cancel
            </sw-button>

            <sw-button
                variant="primary"
                size="small"
                @click="onSave"
            >
                Save action
            </sw-button>
        </template>
    {% endblock %}
</sw-modal>
{% endblock %}
